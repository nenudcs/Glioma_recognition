# Platform-provided persistent workspace.
COMPETITION_WORKSPACE=/2026aicompetition/workspace

# Obtain the complete value from the competition container page.
COMPETITION_CALLBACK_URL=http://platform/api/competition/inference/callback/

# Keep one worker until real models are proven safe for concurrent GPU use.
COMPETITION_MAX_WORKERS=1
COMPETITION_CALLBACK_TIMEOUT=10
COMPETITION_CALLBACK_ATTEMPTS=3

# Real-plugin entry point (start.sh 已默认设置).
COMPETITION_PIPELINE_FACTORY=tasks.real_pipeline:build_pipeline

# ---- Goal1 / Goal2（官方实现）----
# GOAL1_CHECKPOINT=/2026aicompetition/workspace/checkpoint/goal1_authenticity/model.pt
# GOAL2_STITCHED_THRESHOLD=<标定结果>
# GOAL2_DUPLICATE_SIM_CENTER=<标定结果>

# ---- Goal3 / Goal4 / Goal5（本队实现）----
# 权重根：各 Goal 从其下按相对路径解析
#   goal3_tumor/model.pt / goal4_diagnosis/model.pt /
#   goal5_segmentation/{core,flair}.pt
COMPETITION_CHECKPOINT_ROOT=/2026aicompetition/workspace/checkpoint

# 评测健壮性（默认值已按实测结论设好，一般不用改）
GLIOMA_LOADER_TOLERANT=1   # 逐例容错：单例失败只丢该例，不作废整批
GLIOMA_PROGRESS=1          # 逐例进度行
GLIOMA_VOXEL_GUESS_EXCLUDED=0  # 体素判别不覆盖官方表的「其他」（实测一致率低于随机）
# GLIOMA_GOALS=goal3,goal5  # 临时把未列出的 Goal 退回 Dummy（对照实验用）
